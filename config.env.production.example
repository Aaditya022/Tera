# Production-safe template for Tera. Copy to config.env on the target server and fill in
# every REPLACE_ME value. Never commit the filled file or .secrets.
# The dev config.env in this checkout is left untouched.

# Database (same values must be used for POSTGRES_* and DB_*)
POSTGRES_DB=pos
POSTGRES_USER=pos
POSTGRES_PASSWORD=REPLACE_ME_RANDOM_DB_PASSWORD
POSTGRES_PORT=5432
DB_HOST=db
DB_PORT=5432
DB_USER=pos
DB_PASSWORD=REPLACE_ME_RANDOM_DB_PASSWORD
DB_NAME=pos

# JWT signing and payment-secret encryption. Generate two DIFFERENT values:
#   openssl rand -hex 32
# Backend and ws-bridge both read SECRET_KEY from this file via Compose, so they stay in sync.
SECRET_KEY=REPLACE_ME_RANDOM_32_BYTE_HEX
REFRESH_SECRET_KEY=REPLACE_ME_DIFFERENT_RANDOM_32_BYTE_HEX

# Same-origin deployment through HAProxy (80/443 -> front, /api, /ws).
API_URL=/api
WS_URL=
CORS_ORIGINS=https://your-domain.tld
EMAIL_FROM_NAME=Tera

# PRODUCTION=true is set by docker-compose.prod.yml on the back service. It enables Secure
# cookies, stricter rate limits and hides /api/docs; it rejects placeholders and CORS '*'.
# Do not set PRODUCTION or ENABLE_API_DOCS here unless you have a specific reason.

# Optional integrations (leave unset unless configured on the target):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
